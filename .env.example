# WhatsApp Cloud API Credentials
# Get these from https://business.facebook.com following WHATSAPP_CLOUD_API_SETUP.md

# Your WhatsApp Business Phone Number ID (15 digits)
NEXT_PUBLIC_WHATSAPP_PHONE_NUMBER_ID=123456789012345

# Your WhatsApp API Access Token (keep this SECRET)
WHATSAPP_ACCESS_TOKEN=EAAx...your_very_long_token_here...

# Your WhatsApp Business Account ID (optional, for reference)
WHATSAPP_BUSINESS_ACCOUNT_ID=987654321098765
